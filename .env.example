# Database
DATABASE_URL=postgres://localhost:5432/elw_tax_list_targeting

# Server
PORT=3000
NODE_ENV=development

# Client
CLIENT_URL=http://localhost:5173

# Gmail API (for future email integration)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Email Sending (card 07)
# Leave unset (or anything other than "gog") to dry-run: emails are rendered,
# tracked in email_tracking with a synthetic "dry-<uuid>" message id, and
# list_requests are marked email_sent exactly as a real send would, but
# nothing is transmitted. Only set EMAIL_TRANSPORT=gog after explicit human
# sign-off to send real Gmail messages via the `gog` CLI (must be installed
# and authenticated on this machine).
# EMAIL_TRANSPORT=dry_run         # 'dry_run' (default) or 'gog'
# EMAIL_BULK_SEND_DELAY_MS=300    # delay between sequential sends in a bulk request

# AI Contact Research (card 04)
# Leave unset to disable AI research; POST /api/counties/:id/research will return
# a clear 503 and the manual-add/review UI keeps working either way.
# RESEARCH_PROVIDER=mock          # 'mock' (deterministic demo data) or 'http'
# RESEARCH_PROVIDER_URL=          # required when RESEARCH_PROVIDER=http
# RESEARCH_PROVIDER_API_KEY=      # optional bearer token for the http provider
# RESEARCH_ALLOW_MOCK_OVERRIDE=false  # allow per-request mock override in production (not recommended)
# RESEARCH_COOLDOWN_MS=15000      # minimum time between research attempts per county
# RESEARCH_CACHE_TTL_MS=3600000   # how long a completed result is served from cache
